{
  "$schema": "../schema/lidar-3d.schema.json",
  "spec": {
    "type": "lidar_3d",
    "name": "livox_mid360s",
    "frame_id": "livox_mid360s",
    "DetectionDistance": {
      "Min": 100,
      "Max": 100000
    },
    "DistanceAccuracy": [
      {
        "Range": {
          "Min": 100,
          "Max": 500
        },
        "Type": "independent",
        "DistanceIndependentAccuracy": {
          "StdDev": 0.04,
          "NoiseDistribution": "Gaussian"
        }
      },
      {
        "Range": {
          "Min": 500,
          "Max": 100000
        },
        "Type": "independent",
        "DistanceIndependentAccuracy": {
          "StdDev": 0.02,
          "NoiseDistribution": "Gaussian"
        }
      }
    ],
    "AngularAccuracy": 0.15,
    "FieldOfView": {
      "Horizontal": {
        "Min": -180.0,
        "Max": 180.0
      },
      "Vertical": {
        "Min": -7.0,
        "Max": 52.0
      }
    },
    "ScanPattern": {
      "Type": "uniform",
      "PointRate": 200000,
      "FrameRate": 10.0,
      "NonRepetitive": false
    }
  },
  "mjcf_binding": {
    "config_style": "hakoniwa-sdf-like",
    "runtime_source": "mjcf",
    "source_body": "lidar_mount",
    "source_site": "lidar_site",
    "exclude_body": "lidar_mount"
  },
  "pdu_config": {
    "pdu_name": "point_cloud",
    "update_rate_hz": 10.0,
    "message_type": "sensor_msgs/PointCloud2",
    "max_points": 24000,
    "point_step": 16
  }
}
