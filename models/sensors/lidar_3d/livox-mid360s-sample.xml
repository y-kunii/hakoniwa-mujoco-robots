<mujoco model="livox_mid360s_sample">
  <compiler angle="degree"/>
  <option timestep="0.01" gravity="0 0 0"/>

  <visual>
    <global offwidth="1600" offheight="1200"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.35 0.45 0.6" rgb2="0.05 0.06 0.1" width="256" height="256"/>
    <texture name="ground_checker" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.22 0.26 0.32" rgb2="0.14 0.17 0.21"/>
    <material name="ground_mat" texture="ground_checker" texrepeat="30 30" reflectance="0.05"/>
    <material name="near_mat"   rgba="0.85 0.45 0.15 1"/>
    <material name="mid_mat"    rgba="0.25 0.65 0.45 1"/>
    <material name="wall_mat"   rgba="0.60 0.62 0.66 1"/>
    <material name="sensor_mat" rgba="0.08 0.08 0.09 1"/>
  </asset>

  <worldbody>
    <light name="key_light"  pos="0 0 8"   dir="0 0 -1"      diffuse="0.7 0.7 0.7"/>
    <light name="fill_light" pos="-8 -8 6" dir="0.7 0.7 -0.6" diffuse="0.4 0.4 0.4"/>
    <camera name="overview" pos="9 -11 7" mode="targetbody" target="lidar_mount"/>

    <geom name="ground" type="plane" size="40 40 0.1" material="ground_mat"/>

    <!-- ============ Livox Mid-360S on a short post ============
         The housing approximates the real 65 x 65 x 60 mm body. The whole
         mount is the profile's exclude_body so the sensor does not see itself,
         and lidar_site is the profile's source_site, giving the exact ray
         origin 0.5 m above the floor.                                      -->
    <body name="lidar_mount" pos="0 0 0">
      <geom name="post"          type="cylinder" pos="0 0 0.235" size="0.030 0.235" material="sensor_mat"/>
      <geom name="lidar_housing" type="cylinder" pos="0 0 0.500" size="0.0325 0.030" material="sensor_mat"/>
      <site name="lidar_site"    pos="0 0 0.500" size="0.015" rgba="1 0.1 0.1 1"/>
    </body>

    <!-- ===== Near field: exercises the -7 deg lower blind cone =====
         At 0.5 m mounting height the datasheet limit puts the nearest floor
         return at 0.5 / tan(7 deg) = 4.07 m, so a low object closer than that
         returns nothing while a tall one at the same distance does.        -->
    <body name="box_low_near" pos="1.2 0 0.125">
      <geom name="box_low_near_geom" type="box" size="0.30 0.30 0.125" material="near_mat"/>
    </body>
    <body name="box_tall_near" pos="-1.2 0 0.75">
      <geom name="box_tall_near_geom" type="box" size="0.30 0.30 0.75" material="near_mat"/>
    </body>

    <!-- ===== Mid field: fully inside the vertical FOV ===== -->
    <body name="box_mid" pos="0 4 0.40">
      <geom name="box_mid_geom" type="box" size="0.50 0.50 0.40" material="mid_mat"/>
    </body>
    <body name="pole" pos="-4 4 1.25">
      <geom name="pole_geom" type="cylinder" size="0.15 1.25" material="mid_mat"/>
    </body>
    <body name="ball" pos="6 -3 0.60">
      <geom name="ball_geom" type="sphere" size="0.60" material="near_mat"/>
    </body>
    <body name="box_far" pos="-6 -5 0.90">
      <geom name="box_far_geom" type="box" size="0.80 0.80 0.90" material="mid_mat"/>
    </body>

    <!-- ===== Walls: occlusion shadows and the upper FOV limit ===== -->
    <body name="wall_back" pos="0 12 1.50">
      <geom name="wall_back_geom" type="box" size="6.0 0.15 1.50" material="wall_mat"/>
    </body>
    <body name="wall_side" pos="-10 0 1.50">
      <geom name="wall_side_geom" type="box" size="0.15 6.0 1.50" material="wall_mat"/>
    </body>
  </worldbody>
</mujoco>
